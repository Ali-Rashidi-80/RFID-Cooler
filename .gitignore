config.json
cards.json
cards.tmp
outbox.jsonl
outbox.bak
outbox.jsonl.bak
rf_codes.json
rf_codes.tmp

# ── Environment ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.Python
*.egg-info/
dist/
build/

